# Copy to .env next to docker-compose.prod.yml and fill in real values.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://ev.example.com
CLOUD_HTTP_PORT=8180

CLOUD_DB_DATABASE=safircharge_cloud
CLOUD_DB_USERNAME=safir_cloud
CLOUD_DB_PASSWORD=
CLOUD_DB_ROOT_PASSWORD=

# Only honoured when APP_ENV is not "production"
SC_TEST_OTP_CODES=

# simulated (rejected in production) | zarinpal
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
FCM_CREDENTIALS=

# AI support assistant (empty key = FAQ answers + hand-off to staff)
ANTHROPIC_API_KEY=
SUPPORT_AI_MODEL=claude-opus-5-5
SUPPORT_AI_EFFORT=medium
SUPPORT_AI_HOURLY_LIMIT=40
