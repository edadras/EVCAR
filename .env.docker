# SafirCharge Docker — copy to .env or use as reference
CLOUD_HTTP_PORT=8180
EDGE_HTTP_PORT=8182
CLOUD_DB_PORT=3317
EDGE_DB_PORT=3318
CLOUD_REDIS_PORT=6380
EDGE_REDIS_PORT=6381

CLOUD_DB_DATABASE=safircharge_cloud
CLOUD_DB_USERNAME=safir_cloud
CLOUD_DB_PASSWORD=cloud_secret
CLOUD_DB_ROOT_PASSWORD=root_secret

EDGE_DB_DATABASE=safircharge_edge
EDGE_DB_USERNAME=safir_edge
EDGE_DB_PASSWORD=edge_secret
EDGE_DB_ROOT_PASSWORD=root_secret

EDGE_CLOUD_SYNC_TOKEN=dev-sync-token

# Browser probes this edge from the cloud-hosted web app (comma-separated)
SC_EDGE_PROBE_URLS=http://127.0.0.1:8182,http://127.0.0.1:8183
EDGE2_HTTP_PORT=8183
EDGE2_DB_PORT=3319
EDGE2_REDIS_PORT=6382
EDGE2_CLOUD_SYNC_TOKEN=dev-sync-token-2
SC_TEST_OTP_CODES=111111,222222,333333
# When cloud + edge are both reachable (typical in dev), ask user which backend to use
SC_CONNECTIVITY_ASK_MULTIPLE=true

# Edge validates mobile app tokens with the same key as cloud APP_KEY (copy from cloud/.env)
# CLOUD_APP_KEY=base64:...
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
